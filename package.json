{
  "name": "dief-jarvis",
  "version": "1.0.0-alpha.2",
  "private": true,
  "description": "Central de comando pessoal Dief Jarvis.",
  "author": "Equipe Dief",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5194 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5195 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "desktop": "electron .",
    "setup:desktop": "node node_modules/electron/install.js",
    "package:dir": "npm run build && electron-builder --win --dir --publish never",
    "package:portable": "npm run build && electron-builder --win portable --publish never"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "1.49.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "vite": "8.3.2",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "playwright": "1.62.1",
    "pngjs": "7.0.0"
  },
  "overrides": {
    "http-cache-semantics": "4.3.0",
    "@electron/get": {
      "global-agent": "4.1.3"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "build": {
    "appId": "br.com.dief.jarvis",
    "productName": "Dief Jarvis",
    "artifactName": "Dief-Jarvis-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "src/core/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "public/jarvis-mark.ico",
      "requestedExecutionLevel": "asInvoker"
    }
  }
}
